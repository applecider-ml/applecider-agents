# --- who pays for the model (ours) ---
ANTHROPIC_API_KEY=
APPLECIDER_AGENTS_MODEL=claude-opus-5
APPLECIDER_AGENTS_EFFORT=high          # low|medium|high|xhigh|max
APPLECIDER_AGENTS_FALLBACKS=1          # server-side refusal fallback (beta); 0 to disable
# --- what the agent may do ---
FLARE_MODE=dry-run                # dry-run | comment
FLARE_DAILY_CAP=200
FLARE_BASE_RATE=0.0326            # prior for P(anomaly); the benchmark's, far richer than a raw stream
# --- SkyPortal (admin fills in) ---
SKYPORTAL_URL=http://localhost:5000
SKYPORTAL_TOKEN=
SKYPORTAL_GROUP_IDS=
# --- optional ---
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=
BOOM_URL=
BOOM_TOKEN=
# --- data (all optional; defaults: benchmark tables from the public flare repo, light curves fetched) ---
APPLECIDER_AGENTS_HOME=~/.applecider_agents
# APPLECIDER_DATA_DIR=/path/to/flare/benchmark
# APPLECIDER_EVENTS_DIRS=/path/to/events:/another
# APPLECIDER_TEST_SCORES=/path/to/test_split_scores.csv
